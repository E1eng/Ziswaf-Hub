# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS
.DS_Store
Thumbs.db

# Node / Next.js
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/.next/
/out/
/build

# Python (data/seed)
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Misc
*.pem

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (never commit secrets)
.env
.env.local
.env.*.local

# Vercel
.vercel

# Supabase
.supabase/

# TypeScript build artifacts
*.tsbuildinfo
next-env.d.ts
